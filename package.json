{
  "name": "projecttemplate",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": true,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "package.json",
    "package-lock.json"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --production --sourcemap --packages external && bun run build:declaration",
    "build:declaration": "tsc --project tsconfig.build.json",
    "test": "bun test --concurrent --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "prepare": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/eslint-plugin-security": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --cache --fix",
    "*.{ts,js,css,md}": "prettier --write",
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
